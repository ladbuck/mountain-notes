{
  "name": "Mountain Notes",
  "short_name": "Mountain Notes",
  "description": "Teach from your HTML notes and PDFs with S Pen and Apple Pencil.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "fullscreen",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#edf1f5",
  "theme_color": "#1d3f72",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "files",
          "accept": [
            "text/html",
            "application/xhtml+xml",
            "application/pdf",
            ".html",
            ".htm",
            ".pdf"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/html": [
          ".html",
          ".htm"
        ],
        "application/pdf": [
          ".pdf"
        ]
      },
      "launch_type": "single-client"
    }
  ]
}
